{
  "id": "b5f37b8e-3f98-4201-9000-a73c571c6131",
  "name": "Recurring Ops | Task recurrence",
  "active": false,
  "settings": {
    "timezone": "Asia/Kolkata",
    "executionOrder": "v1"
  },
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9-23 * * 1-5"
            }
          ]
        }
      },
      "id": "schedule-recurrence",
      "name": "Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.OPS_WEB_APP_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ action: \"recurrence\", token: $env.OPS_SHARED_TOKEN }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "http-recurrence",
      "name": "Call Apps Script state engine",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        300
      ]
    }
  ],
  "connections": {
    "Schedule": {
      "main": [
        [
          {
            "node": "Call Apps Script state engine",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "tags": []
}

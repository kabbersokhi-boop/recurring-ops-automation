{
  "id": "ops-qa-leadership",
  "name": "Recurring Ops QA | leadership",
  "active": false,
  "nodes": [
    {
      "id": "run-qa-scenario",
      "name": "Run QA scenario",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        180
      ],
      "parameters": {}
    },
    {
      "id": "qa-schedule",
      "name": "QA schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        420
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/15 14-23 * * 1-5"
            }
          ]
        }
      }
    },
    {
      "id": "evaluate-business-state",
      "name": "Evaluate business state",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.OPS_QA_WEB_APP_URL }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpCustomAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"action\":\"leadership\"}",
        "options": {
          "timeout": 60000
        }
      },
      "credentials": {
        "httpCustomAuth": {
          "id": "REPLACE_QA_HTTP_CREDENTIAL_ID",
          "name": "Recurring Ops QA | isolated script token"
        }
      },
      "retryOnFail": false
    },
    {
      "id": "pending-notifications",
      "name": "Pending notifications",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "jsCode": "if ($json.ok !== true) throw new Error($json.error||'QA evaluation rejected'); return ($json.notifications||[]).map(n=>({json:n}));"
      }
    },
    {
      "id": "claim-once",
      "name": "Claim once",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.OPS_QA_WEB_APP_URL }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpCustomAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({action:'claim',key:$json.key}) }}",
        "options": {
          "timeout": 60000
        }
      },
      "credentials": {
        "httpCustomAuth": {
          "id": "REPLACE_QA_HTTP_CREDENTIAL_ID",
          "name": "Recurring Ops QA | isolated script token"
        }
      },
      "retryOnFail": false
    },
    {
      "id": "verify-claim-result",
      "name": "Verify claim result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        770,
        300
      ],
      "parameters": {
        "jsCode": "for (const item of $input.all()) if (item.json.ok !== true) throw new Error(item.json.error||'QA claim rejected'); return $input.all();"
      }
    },
    {
      "id": "mailpit-claim-accepted",
      "name": "Mailpit claim accepted",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        880,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "claimed",
              "leftValue": "={{ $json.claimed }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "capture-through-existing-mailpit",
      "name": "Capture through existing Mailpit",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1100,
        300
      ],
      "parameters": {
        "fromEmail": "ops-qa@ops-demo.test",
        "toEmail": "={{ $json.recipient }}",
        "subject": "={{ $json.subject }}",
        "emailFormat": "text",
        "text": "={{ $json.body }}",
        "options": {
          "appendAttribution": false
        }
      },
      "credentials": {
        "smtp": {
          "id": "REPLACE_QA_MAILPIT_CREDENTIAL_ID",
          "name": "Recurring Ops QA | existing Mailpit SMTP"
        }
      },
      "retryOnFail": false,
      "onError": "continueRegularOutput"
    },
    {
      "id": "record-transport-outcome",
      "name": "Record transport outcome",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.OPS_QA_WEB_APP_URL }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpCustomAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({action:'receipt',key:$('Claim once').item.json.key,success:!$json.error,messageId:$json.messageId||'',executionId:$execution.id}) }}",
        "options": {
          "timeout": 60000
        }
      },
      "credentials": {
        "httpCustomAuth": {
          "id": "REPLACE_QA_HTTP_CREDENTIAL_ID",
          "name": "Recurring Ops QA | isolated script token"
        }
      },
      "retryOnFail": false
    },
    {
      "id": "verify-recorded-outcome",
      "name": "Verify recorded outcome",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        300
      ],
      "parameters": {
        "jsCode": "for (const item of $input.all()) { if (item.json.ok !== true) throw new Error(item.json.error||'QA receipt rejected'); if (item.json.state === 'UNKNOWN') throw new Error('Delivery outcome uncertain; reconcile captured messages before any resend'); } return $input.all();"
      }
    }
  ],
  "connections": {
    "Run QA scenario": {
      "main": [
        [
          {
            "node": "Evaluate business state",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "QA schedule": {
      "main": [
        [
          {
            "node": "Evaluate business state",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Evaluate business state": {
      "main": [
        [
          {
            "node": "Pending notifications",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Pending notifications": {
      "main": [
        [
          {
            "node": "Claim once",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claim once": {
      "main": [
        [
          {
            "node": "Verify claim result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Verify claim result": {
      "main": [
        [
          {
            "node": "Mailpit claim accepted",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Mailpit claim accepted": {
      "main": [
        [
          {
            "node": "Capture through existing Mailpit",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Capture through existing Mailpit": {
      "main": [
        [
          {
            "node": "Record transport outcome",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Record transport outcome": {
      "main": [
        [
          {
            "node": "Verify recorded outcome",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "timezone": "Asia/Kolkata",
    "executionOrder": "v1",
    "saveDataSuccessExecution": "all",
    "saveDataErrorExecution": "all",
    "saveManualExecutions": true
  },
  "pinData": {},
  "tags": []
}
